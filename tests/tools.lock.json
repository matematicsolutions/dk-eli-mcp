    "dk_recent_changes": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "List Danish documents changed on a given date (harvest API).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "description": "``YYYY-MM-DD`` (e.g. ``\"2026-06-26\"``). The harvest API is available\n03:00-23:45 Danish time; an empty list is a valid \"nothing changed\" result.",
              "type": "string"
            }
          },
          "required": [
            "date"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "dk_recent_changes",
        "outputSchema": {
          "additionalProperties": true,
          "description": "Result of ``dk_recent_changes``.",
          "properties": {
            "availability_note": {
              "default": "The harvest API (api.retsinformation.dk) is only available 03:00-23:45 Danish time; outside that window it returns an error. An empty list means no documents changed on that date, which is a valid result.",
              "type": "string"
            },
            "dataset_note": {
              "default": "Retsinformation serves Danish consolidated legislation as LexDania 2.1 XML behind native ELI URIs. Address a document by ELI coordinate (year + number in the 'lta' collection = Lovtidende A) or by its accession number; there is no free-text search. dk_recent_changes lists documents changed on a given date via the harvest API (available 03:00-23:45 Danish time). Covers laws (LOV), consolidated laws (LBK), executive orders (BEK), circulars (CIR) and guidelines (VEJ). Language: Danish.",
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "items": {
              "items": {
                "additionalProperties": true,
                "description": "A single document-change entry from the harvest API.",
                "properties": {
                  "accession_number": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "change_date": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "document_type": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "eli_uri": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "reason_for_change": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "source_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "date",
            "total"
          ],
          "type": "object"
        }
      },
      "sha256": "bd6f1ca7bbc67561efe92169afd415d32cf172336882dbcb486c65527fbd2bf0"
    }
